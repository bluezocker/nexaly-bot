# Nexaly worker — no tsc in image, start via tsx
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
COPY tsconfig.base.json package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @nexaly/database generate

FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN addgroup -S nexaly && adduser -S nexaly -G nexaly
WORKDIR /app
COPY --from=deps /app /app
# Upload-Ordner muss dem App-Nutzer gehören (Welcome-Hintergründe)
RUN mkdir -p /app/uploads && chown nexaly:nexaly /app/uploads
USER nexaly
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@nexaly/worker", "start"]
