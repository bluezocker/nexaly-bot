# Nexaly API — no tsc in image, start via tsx
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
COPY tsconfig.base.json package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @nexaly/database generate

FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN addgroup -S nexaly && adduser -S nexaly -G nexaly
WORKDIR /app
COPY --from=deps /app /app
USER nexaly
ENV NODE_ENV=production
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3001/v1/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@nexaly/api", "start"]
