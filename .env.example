NODE_ENV=development
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

POSTGRES_USER=nexaly
POSTGRES_PASSWORD=nexaly
POSTGRES_DB=nexaly
DATABASE_URL=postgresql://nexaly:nexaly@localhost:5432/nexaly?schema=public
REDIS_URL=redis://localhost:6379

# min. 32 Zeichen — in Production niemals den Beispielwert
SESSION_SECRET=dev-only-session-secret-not-for-production

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_DEV_GUILD_ID=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# X API v2 app-only bearer. Muss User-Timelines lesen dürfen.
X_BEARER_TOKEN=
# Threads-App. Redirect exakt https://nexaly.app/api/auth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://nexaly.app/api/auth/threads/callback

ASSET_DIR=./uploads
